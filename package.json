{
  "name": "p1intdops",
  "version": "1.0.0",
  "description": "API REST con automatización CI/CD y pruebas con Jest",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "test": "jest",
    "test:coverage": "jest --coverage --forceExit --detectOpenHandles"
  },
  "keywords": [
    "devops",
    "ci-cd",
    "express",
    "sqlite",
    "jest",
    "docker"
  ],
  "author": "Job De La Vega Villalobos",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/P1IntdOps-main/"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 70,
        "statements": 70
      }
    }
  }
}
